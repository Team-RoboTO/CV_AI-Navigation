<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoaim_realsense</name>
  <version>1.0.0</version>
  <description>Optional RealSense detector for the RoboMaster autoaim pipeline</description>
  <maintainer email="team@example.com">team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>autoaim</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>std_msgs</depend>
  <depend>librealsense2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
