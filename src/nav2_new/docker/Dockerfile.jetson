# =============================================================================
# Dockerfile.jetson — ROS 2 Humble + Nav2 + FAST_LIO + Livox for Jetson
# =============================================================================
# Target: NVIDIA Jetson Orin with JetPack 6 (Ubuntu 22.04).
#
# Expected build context (your ~/roboto/ folder):
#
#   ./nav2_ws/src/
#       ├── nav2/
#       ├── Livox-SDK2/
#       ├── livox_ros_driver2/
#       ├── FAST_LIO_ROS2/
#       └── livox_converter/
#
# Build:
#   cd ~/roboto
#   docker build -t roboto/nav:latest -f nav2_ws/src/nav2/docker/Dockerfile.jetson .
#
# Run: see scripts/run_nav_docker.sh
# =============================================================================
FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble

# ── Base dev tools + ROS 2 Nav stack + libs ─────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git wget curl vim \
      python3-pip python3-colcon-common-extensions \
      python3-rosdep python3-vcstool \
      libpcl-dev libeigen3-dev \
      libapr1-dev libaprutil1-dev \
      net-tools iputils-ping iproute2 \
      ros-${ROS_DISTRO}-navigation2 \
      ros-${ROS_DISTRO}-nav2-bringup \
      ros-${ROS_DISTRO}-nav2-simple-commander \
      ros-${ROS_DISTRO}-slam-toolbox \
      ros-${ROS_DISTRO}-pointcloud-to-laserscan \
      ros-${ROS_DISTRO}-tf-transformations \
      ros-${ROS_DISTRO}-pcl-conversions \
      ros-${ROS_DISTRO}-pcl-ros \
      ros-${ROS_DISTRO}-rviz2 \
      ros-${ROS_DISTRO}-rqt-tf-tree \
   && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir pyyaml transforms3d

# ── Workspace ───────────────────────────────────────────────────────────────
WORKDIR /root/nav2_ws

# Copy sources
COPY ./nav2_ws/src /root/nav2_ws/src

# ── Step 1: Build Livox-SDK2 as a plain CMake project → installs to /usr/local
# The driver (livox_ros_driver2) does:
#   find_library(... liblivox_lidar_sdk_shared.so /usr/local/lib REQUIRED)
# so the SDK must be in /usr/local/lib BEFORE colcon runs.
# We also place a COLCON_IGNORE file so colcon doesn't try to treat it as a
# ROS package (it has no package.xml but colcon would still descend into it).
RUN cd /root/nav2_ws/src/Livox-SDK2 && \
    touch COLCON_IGNORE && \
    mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    make install && \
    ldconfig

# ── Step 2: Prep livox_ros_driver2 for ROS 2 ────────────────────────────────
# The upstream repo ships package_ROS1.xml + package_ROS2.xml.
# Copy the ROS 2 variants into the names colcon expects.
RUN cd /root/nav2_ws/src/livox_ros_driver2 && \
    cp package_ROS2.xml package.xml

# ── Step 3: Build the ROS 2 workspace ───────────────────────────────────────
# -DROS_EDITION=ROS2     selects the ROS 2 build path in livox CMakeLists.
# -DHUMBLE_ROS=humble    !! MUST KEEP !! livox_ros_driver2/CMakeLists has:
#                          if(HUMBLE_ROS STREQUAL "humble")
#                            rosidl_get_typesupport_target(...)  ← correct Humble API
#                          else()
#                            get_target_property(LIVOX_INTERFACES_INCLUDE_DIRECTORIES ...)
#                          endif()
#                        Without this flag the else() branch runs and
#                        LIVOX_INTERFACES_INCLUDE_DIRECTORIES is NOTFOUND.
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    cd /root/nav2_ws && \
    colcon build --symlink-install \
      --packages-ignore Livox-SDK2 \
      --cmake-args -DROS_EDITION=ROS2 -DHUMBLE_ROS=humble \
      --event-handlers console_direct+"

# ── Shell environment ───────────────────────────────────────────────────────
RUN echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> /root/.bashrc && \
    echo 'source /root/nav2_ws/install/setup.bash' >> /root/.bashrc && \
    echo 'export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}' >> /root/.bashrc && \
    echo 'export RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}' >> /root/.bashrc

WORKDIR /root/nav2_ws
CMD ["/bin/bash"]
